# Modalidad local. No subir .env real a GitHub.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Supabase: completar DATABASE_URL y DATA_SECRET. Ver EMPEZAR_AQUI.md.
DATABASE_URL=
DATA_SECRET=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Certificado CA PEM sólo si lo requiere tu proyecto; TLS siempre se verifica.
DATABASE_CA=
CLINICAL_ENABLED=false
DEMO_MODE=false
# Alternativa SQLite local:
DB_PATH=./data/salud-visual.sqlite
DATA_KEY=
