{
  "name": "haciendo-la-vista-gorda",
  "version": "1.2.1",
  "private": true,
  "description": "Registro y seguimiento de salud visual escolar",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "node scripts/demo.js",
    "dev": "node scripts/preview.js",
    "setup": "node scripts/setup.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test:e2e": "node tests/browser.mjs"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11"
  }
}
